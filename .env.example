# ============ LLM ============
# mock(默认,零依赖可跑通) | openai(接任意 OpenAI 兼容,含 DeepSeek/通义/智谱)
LLM_MODE=mock
# —— 接 DeepSeek（用户选定）——
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
# 其他可选：
#   通义千问: OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1  OPENAI_MODEL=qwen-plus
#   智谱 GLM: OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4            OPENAI_MODEL=glm-4

# ============ 真实后端（医院 Laravel 平台 / Dify 工具回调接口）============
# 📌 小萱同源：AI 服务当脑子，业务建单走 Laravel。填你服务器的 API 基址（含 /api）。
#    例：https://your-domain.com/api   或   http://120.x.x.x:8080/api
#    本地联调用桩后端：先 `uvicorn scripts.stub_backend:app --port 9000`，再填 http://127.0.0.1:9000/api
BACKEND_BASE_URL=
BACKEND_TIMEOUT=15

# ============ RAG / Embedding ============
RAG_TOP_K=3
CHUNK_SIZE=120
CHUNK_OVERLAP=30
# bge(默认,本地正式模型,数据不出域) | mock(本地哈希,零依赖开发兜底) | openai(API 预留)
EMBEDDING_MODE=bge
EMBEDDING_MODEL=BAAI/bge-m3
# 本地模型缓存目录（不存在则首次自动从 HuggingFace/hf-mirror 下载）
EMBEDDING_MODEL_PATH=./models/bge-m3

# ============ 向量库（pgvector：PostgreSQL 向量扩展）============
# 📌 真向量库：向量存进 PostgreSQL 的 kb_chunks 表（HNSW ANN 索引），多租户按行级过滤 tenant_id 隔离。
#   前置：本机装好 PostgreSQL 并启用 pgvector 扩展（见 README「pgvector 接入」）。
#   连接串格式：postgresql://用户名:密码@主机:端口/数据库名
#   维度与模型强绑定：bge-m3=1024 维；换模型需改 EMBEDDING_DIM 并重建表
PGVECTOR_DSN=postgresql://postgres:你的密码@localhost:5432/ai_service
EMBEDDING_DIM=1024

# ============ 鉴权 ============
# dev(固定默认上下文,可用请求头模拟角色) | jwt
AUTH_MODE=dev
JWT_SECRET=dev-secret-change-me
DEV_TENANT=capital-medical
DEV_USER=teacher-001
# admin | teacher | student
DEV_ROLE=teacher

# ============ Agent ============
MAX_STEPS=6
ENABLE_REFLECTION=true

# ============ 服务 ============
HOST=0.0.0.0
PORT=8000

# ============ Redis（生产级别：多副本一致 + Lua 原子化）============
# 📌 单 worker demo + 100 学员试点用默认（SQLite + 进程内）即可；
#   真生产（多 worker / 跨实例）必须切到 redis 后端。
#   - backend=redis 但 REDIS_URL 不可达 → 启动期 fail-fast 直接拒绝
REDIS_URL=
# sqlite | redis
MEMORY_BACKEND=sqlite
# memory(进程内 Dict) | redis(集中状态)
GOVERNANCE_BACKEND=memory
# 记忆在 Redis 里的 TTL（秒），默认 3600
MEMORY_REDIS_TTL_SECONDS=3600
